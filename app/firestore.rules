rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validEnvelope(data) {
      return data.keys().hasOnly(['ownerUid', 'recordUuid', 'recordTypeCode', 'schemaVersion', 'keyVersion', 'revision', 'updatedAt', 'deleted', 'nonce', 'ciphertext', 'tag', 'deviceId'])
        && data.ownerUid is string && data.recordUuid is string
        && data.recordTypeCode is string && data.schemaVersion == 1
        && data.keyVersion is int && data.keyVersion >= 1
        && data.revision is int && data.revision >= 1
        && data.updatedAt == request.time && data.deleted is bool
        && data.nonce is bytes && data.nonce.size() == 12
        && data.ciphertext is bytes && data.ciphertext.size() <= 900000
        && data.tag is bytes && data.tag.size() == 16
        && data.deviceId is string;
    }
    function deviceAllowed(uid, deviceId) {
      return exists(/databases/$(database)/documents/users/$(uid)/devices/$(deviceId))
        && get(/databases/$(database)/documents/users/$(uid)/devices/$(deviceId)).data.status != 'revoked';
    }
    match /users/{uid}/records/{recordId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) && request.resource.data.ownerUid == uid
        && request.resource.data.recordUuid == recordId
        && deviceAllowed(uid, request.resource.data.deviceId)
        && validEnvelope(request.resource.data);
      allow update: if signedInAs(uid) && resource.data.ownerUid == uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.recordUuid == resource.data.recordUuid
        && request.resource.data.revision > resource.data.revision
        && deviceAllowed(uid, request.resource.data.deviceId)
        && validEnvelope(request.resource.data);
      allow delete: if false;
    }
    match /users/{uid}/devices/{deviceId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && request.resource.data.deviceId == deviceId
        && request.resource.data.status == 'pending';
      allow update: if signedInAs(uid)
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.status != 'revoked';
      allow delete: if false;
    }
    match /users/{uid}/recovery/{recoveryId} {
      allow read, create, update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['version', 'kdf', 'salt', 'nonce', 'ciphertext', 'tag', 'keyVersion', 'updatedAt']);
      allow delete: if signedInAs(uid);
    }
    match /users/{uid}/syncState/{deviceId} {
      allow read, write: if signedInAs(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
